---
// Education.astro
import { education, competencies, personalInfo } from '../data/cvData';
---

<section id="education" class="py-16 border-t border-slate-200/60 dark:border-slate-800/60">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="mb-12">
      <div class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-primary-600 dark:text-primary-400 mb-2">
        <span class="w-2 h-2 rounded-full bg-primary-500"></span>
        Background & Languages
      </div>
      <h2 class="text-3xl font-bold tracking-tight text-slate-900 dark:text-white sm:text-4xl">
        Education & Competencies
      </h2>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      
      <!-- Education Card -->
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-primary-50 dark:bg-primary-950/50 border border-primary-200/60 dark:border-primary-800/50 text-primary-600 dark:text-primary-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path d="M12 14l9-5-9-5-9 5 9 5z"></path>
              <path d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z"></path>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222"></path>
            </svg>
          </div>
          <span class="text-xs font-mono text-primary-600 dark:text-primary-400 uppercase tracking-wider">{education.degree}</span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">
            {education.department}
          </h3>
          <p class="text-slate-600 dark:text-slate-300 text-sm mt-1">
            {education.institution}
          </p>
        </div>
        <div class="mt-4 pt-4 border-t border-slate-100 dark:border-slate-800 flex items-center justify-between text-xs text-slate-500 dark:text-slate-400">
          <span>Graduated {education.graduationYear}</span>
          <span>{education.location}</span>
        </div>
      </div>

      <!-- Spoken Languages Card -->
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-sky-50 dark:bg-sky-950/50 border border-sky-200/60 dark:border-sky-800/50 text-sky-600 dark:text-sky-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
            </svg>
          </div>
          <span class="text-xs font-mono text-sky-600 dark:text-sky-400 uppercase tracking-wider">Languages</span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">
            Linguistic Proficiency
          </h3>
          <div class="mt-4 space-y-2.5">
            {competencies.languages.map((lang) => (
              <div class="flex items-center justify-between text-sm">
                <span class="font-medium text-slate-700 dark:text-slate-200">{lang.name}</span>
                <span class="text-xs font-mono text-slate-500 dark:text-slate-400 px-2 py-0.5 rounded bg-slate-100 dark:bg-slate-800">{lang.level}</span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Interests Card -->
      <div class="p-6 rounded-2xl bg-white dark:bg-slate-900/60 border border-slate-200/80 dark:border-slate-800/80 shadow-sm flex flex-col justify-between">
        <div>
          <div class="w-10 h-10 rounded-xl bg-amber-50 dark:bg-amber-950/50 border border-amber-200/60 dark:border-amber-800/50 text-amber-600 dark:text-amber-400 flex items-center justify-center mb-4">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <span class="text-xs font-mono text-amber-600 dark:text-amber-400 uppercase tracking-wider">Beyond Coding</span>
          <h3 class="text-lg font-bold text-slate-900 dark:text-white mt-1">
            Personal Interests
          </h3>
          <div class="mt-4 flex flex-wrap gap-2">
            {competencies.interests.map((interest) => (
              <span class="px-2.5 py-1 text-xs rounded-lg bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300 border border-slate-200/60 dark:border-slate-700/60">
                {interest}
              </span>
            ))}
          </div>
        </div>
      </div>

    </div>

    <!-- Download Resume Callout Banner -->
    <div class="mt-10 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-slate-900 to-slate-800 dark:from-slate-900/90 dark:to-primary-950/40 border border-slate-700/80 shadow-lg text-white flex flex-col sm:flex-row items-center justify-between gap-6">
      <div class="space-y-1 text-center sm:text-left">
        <h3 class="text-lg sm:text-xl font-bold">Want to review the complete CV document?</h3>
        <p class="text-sm text-slate-300">
          Download the official PDF format including all career details and verification records.
        </p>
      </div>

      <div class="flex items-center gap-3">
        <a
          href={personalInfo.resumePdfUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold bg-white/10 hover:bg-white/20 text-white border border-white/20 backdrop-blur transition-all hover:scale-105"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path></svg>
          <span>Preview PDF</span>
        </a>

        <a
          href={personalInfo.resumePdfUrl}
          download
          class="inline-flex items-center gap-2 px-5 py-2 rounded-xl text-sm font-semibold bg-primary-500 hover:bg-primary-400 text-white shadow-md shadow-primary-500/30 transition-all hover:scale-105"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
          <span>Download PDF</span>
        </a>
      </div>
    </div>

  </div>
</section>
